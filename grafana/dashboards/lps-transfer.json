    "LPS",
    "Performance"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "links": [
    {
      "title": "Requests",
      "type": "link",
      "url": "/d/lps-requests",
      "includeVars": true,
      "keepTime": true,
      "targetBlank": false,
      "asDropdown": false
    },
    {
      "title": "Latency",
      "type": "link",
      "url": "/d/lps-latency",
      "includeVars": true,
