          "query": "from(bucket: ${bucket:doublequote})\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"cumulative_requests\")\n  |> filter(fn: (r) => r.plan_name == ${plan_name:doublequote})\n  |> filter(fn: (r) => r.round_name == ${round_name:doublequote})\n  |> filter(fn: (r) => r.iteration_name == ${iteration_name:doublequote})\n  |> filter(fn: (r) => r.target == ${target:doublequote})\n  |> filter(fn: (r) => r._field == \"requests_count\" or r._field == \"failed_count\")\n  |> last()\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({_time: r._time, _field: \"error_rate\", _value: if r.requests_count > 0 then float(v: r.failed_count) / float(v: r.requests_count) else 0.0}))"
