  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Data source",
        "type": "datasource",
        "query": "influxdb",
        "current": {
          "text": "LPS InfluxDB",
          "value": "lps-influxdb"
        },
        "refresh": 1,
        "options": []
      },
      {
        "name": "bucket",
        "label": "Bucket",
        "type": "textbox",
        "query": "LPS_Metrics",
        "current": {
          "text": "LPS_Metrics",
          "value": "LPS_Metrics"
        },
        "options": []
      },
      {
        "name": "plan_name",
        "label": "Run",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "sort": 2,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {},
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: ${bucket:doublequote}, tag: \"plan_name\", start: v.timeRangeStart, stop: v.timeRangeStop,\n  predicate: (r) => r._measurement == \"cumulative_requests\")"
      },
      {
        "name": "round_name",
        "label": "Round",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {},
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: ${bucket:doublequote}, tag: \"round_name\", start: v.timeRangeStart, stop: v.timeRangeStop,\n  predicate: (r) => r._measurement == \"cumulative_requests\" and r.plan_name == ${plan_name:doublequote})"
      },
      {
        "name": "iteration_name",
        "label": "Iteration",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {},
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: ${bucket:doublequote}, tag: \"iteration_name\", start: v.timeRangeStart, stop: v.timeRangeStop,\n  predicate: (r) => r._measurement == \"cumulative_requests\" and r.plan_name == ${plan_name:doublequote} and r.round_name == ${round_name:doublequote})"
      },
      {
        "name": "target",
        "label": "Target",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${datasource}"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "options": [],
        "current": {},
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: ${bucket:doublequote}, tag: \"target\", start: v.timeRangeStart, stop: v.timeRangeStop,\n  predicate: (r) => r._measurement == \"cumulative_requests\" and r.plan_name == ${plan_name:doublequote} and r.round_name == ${round_name:doublequote} and r.iteration_name == ${iteration_name:doublequote})"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Total requests",
      "type": "stat",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 3
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "from(bucket: ${bucket:doublequote})\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"cumulative_requests\")\n  |> filter(fn: (r) => r.plan_name == ${plan_name:doublequote})\n  |> filter(fn: (r) => r.round_name == ${round_name:doublequote})\n  |> filter(fn: (r) => r.iteration_name == ${iteration_name:doublequote})\n  |> filter(fn: (r) => r.target == ${target:doublequote})\n  |> filter(fn: (r) => r._field == \"requests_count\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\", \"_field\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "locale",
          "noValue": "No data",
          "color": {
            "mode": "fixed",
            "fixedColor": "#22d3ee"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value",
        "justifyMode": "auto",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
