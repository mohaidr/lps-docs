    {
      "id": 9,
      "title": "Bytes per window",
      "type": "timeseries",
      "datasource": {
        "type": "influxdb",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 6,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${datasource}"
          },
          "query": "import \"regexp\"\ntargetOrigin = regexp.replaceAllString(r: /^(https?:\\/\\/[^\\/]+).*$/, v: ${target:doublequote}, t: \"$1\")\nfrom(bucket: ${bucket:doublequote})\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"windowed_data_transfer\")\n  |> filter(fn: (r) => r.plan_name == ${plan_name:doublequote})\n  |> filter(fn: (r) => r.round_name == ${round_name:doublequote})\n  |> filter(fn: (r) => r.iteration_name == ${iteration_name:doublequote})\n  |> filter(fn: (r) => r.target == ${target:doublequote} or r.target == targetOrigin)\n  |> filter(fn: (r) => r._field == \"data_sent\" or r._field == \"data_received\")\n  |> keep(columns: [\"_time\", \"_value\", \"_field\", \"metric\", \"status_code\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "noValue": "No data",
          "color": {
            "mode": "palette-classic"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "axisBorderShow": false,
            "axisColorMode": "text",
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            },
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "data_sent"
            },
            "properties": [
